# VPN-only Search. Append to the existing VPS Caddyfile after validation.
search.goreecloud.com {
    tls {
        dns porkbun {
            api_key {$PORKBUN_API_KEY}
            api_secret_key {$PORKBUN_API_SECRET_KEY}
        }
        propagation_delay 30s
        propagation_timeout 10m
        resolvers 1.1.1.1 8.8.8.8
    }

    header {
        Strict-Transport-Security "max-age=31536000"
        X-Content-Type-Options nosniff
        Referrer-Policy no-referrer
        X-Robots-Tag "noindex, nofollow"
    }

    @netbird_client remote_ip 100.64.0.0/10
    handle @netbird_client {
        reverse_proxy goreecloud-search-gateway:8080
    }
    respond "Forbidden" 403
}
